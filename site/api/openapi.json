{
  "openapi": "3.1.0",
  "info": {
    "title": "WeChat to Markdown Store API",
    "version": "1.0.0",
    "description": "用于 wx2md 购买页查询套餐、创建订单和查询订单状态的 API。"
  },
  "servers": [
    { "url": "https://work.bzjkmn.cn/api/v1/store" }
  ],
  "paths": {
    "/products/list": {
      "post": {
        "summary": "查询可购买套餐",
        "operationId": "listProducts",
        "responses": { "200": { "description": "套餐列表" } }
      }
    },
    "/orders/create": {
      "post": {
        "summary": "创建购买订单或读取订单状态",
        "operationId": "createOrder",
        "responses": { "200": { "description": "订单状态" } }
      }
    },
    "/orders/detail": {
      "post": {
        "summary": "查询订单详情",
        "operationId": "getOrder",
        "responses": { "200": { "description": "订单状态与交付信息" } }
      }
    }
  }
}
